{
  "name": "IMPERIO",
  "productName": "IMPERIO",
  "description": "Applicazione professionale per presentazioni e quiz musicali",
  "author": "Pietro Ghidoni",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"npm run vite-dev\" \"npm run electron-dev\"",
    "vite-dev": "vite",
    "electron-dev": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "build": "tsc -b && vite build",
    "electron-build": "npm run build && electron-builder",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^5.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.9",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.imperio.app",
    "mac": {
      "target": {
        "target": "default",
        "arch": "universal"
      }
    },
    "directories": {
      "output": "../App-Builds"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ]
  }
}
